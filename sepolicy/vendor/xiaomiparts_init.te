# Installed in system_ext: the control-property actions run as system init.
allow init vendor_sysfs_xiaomiparts_touch:file setattr;
allow init vendor_sysfs_battery_supply:dir search;
allow init vendor_sysfs_battery_supply:lnk_file r_file_perms;
allow init vendor_sysfs_battery_supply:file setattr;
allow init vendor_sysfs_graphics:dir search;
allow init vendor_sysfs_graphics:lnk_file r_file_perms;
allow init vendor_sysfs_graphics:file setattr;
allow init vendor_sysfs_kgsl:dir search;
allow init vendor_sysfs_kgsl:lnk_file r_file_perms;
allow init vendor_sysfs_kgsl:file w_file_perms;
